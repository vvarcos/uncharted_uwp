# Full bbgpu UWP dependencies, pinned below xbox/.local/deps.
set(d "${UNCHARTED_DEPS_ROOT}")
foreach(required ffmpeg-install/lib/libavcodec.a glslang-install/bin/glslang.exe fmt/CMakeLists.txt sdl/CMakeLists.txt boost/include)
  if(NOT EXISTS "${d}/${required}")
    message(FATAL_ERROR "${d}/${required} is missing: run xbox/scripts/build-deps.ps1")
  endif()
endforeach()
set(saved_c "${CMAKE_C_STANDARD_LIBRARIES}")
set(saved_cxx "${CMAKE_CXX_STANDARD_LIBRARIES}")
set(CMAKE_C_STANDARD_LIBRARIES "${CMAKE_C_STANDARD_LIBRARIES_INIT}")
set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES_INIT}")
set(FMT_INSTALL OFF CACHE BOOL "" FORCE)
set(FMT_DOC OFF CACHE BOOL "" FORCE)
set(FMT_TEST OFF CACHE BOOL "" FORCE)
set(FMT_MODULE OFF CACHE BOOL "" FORCE)
add_subdirectory("${d}/fmt" "${CMAKE_BINARY_DIR}/deps/fmt" EXCLUDE_FROM_ALL)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
foreach(option SDL_TEST_LIBRARY SDL_TESTS SDL_EXAMPLES SDL_INSTALL SDL_UNINSTALL SDL_AUDIO SDL_VIDEO SDL_JOYSTICK SDL_HAPTIC SDL_HIDAPI SDL_SENSOR SDL_POWER SDL_DIALOG SDL_FILESYSTEM SDL_LOCALE SDL_MISC SDL_TRAY SDL_PTHREADS SDL_CLOCK_GETTIME SDL_LIBICONV SDL_SYSTEM_ICONV SDL_OPENVR SDL_PIPEWIRE)
 set(${option} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${d}/sdl" "${CMAKE_BINARY_DIR}/deps/sdl" EXCLUDE_FROM_ALL)
add_library(PkgConfig::SDL3 ALIAS SDL3-static)
set(CMAKE_C_STANDARD_LIBRARIES "${saved_c}")
set(CMAKE_CXX_STANDARD_LIBRARIES "${saved_cxx}")
add_library(Boost::headers INTERFACE IMPORTED GLOBAL)
set_target_properties(Boost::headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${d}/boost/include")
add_library(tsl::robin_map INTERFACE IMPORTED GLOBAL)
set_target_properties(tsl::robin_map PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${d}/robin-map/include")
add_library(GPUOpen::VulkanMemoryAllocator INTERFACE IMPORTED GLOBAL)
set_target_properties(GPUOpen::VulkanMemoryAllocator PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${d}/vma/include")
if(NOT TARGET Vulkan::Headers)
 add_library(VulkanHeadersFull INTERFACE)
 add_library(Vulkan::Headers ALIAS VulkanHeadersFull)
 target_include_directories(VulkanHeadersFull INTERFACE "${d}/vulkan-headers/include")
endif()
set(GLSLANG_COMPILER "${d}/glslang-install/bin/glslang.exe")
add_library(PkgConfig::FFMPEG INTERFACE IMPORTED GLOBAL)
set_target_properties(PkgConfig::FFMPEG PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${d}/ffmpeg-install/include" INTERFACE_LINK_LIBRARIES "${d}/ffmpeg-install/lib/libavformat.a;${d}/ffmpeg-install/lib/libavcodec.a;${d}/ffmpeg-install/lib/libavutil.a;${d}/ffmpeg-install/lib/libswscale.a;${d}/ffmpeg-install/lib/libswresample.a")
add_library(uncharted_xxhash STATIC "${d}/xxhash/xxhash.c")
target_include_directories(uncharted_xxhash PUBLIC "${d}/xxhash")
add_library(PkgConfig::XXHASH ALIAS uncharted_xxhash)
if(NOT TARGET Zydis::Zydis)
 add_library(Zydis::Zydis ALIAS Zydis)
endif()
